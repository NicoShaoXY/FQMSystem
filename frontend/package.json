{
  "name": "fqmsystem",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "buildMac": "vite build && electron-builder --mac --x64 --arm64",
    "buildWin": "vite build && electron-builder --win --x64",
    "build:mac": "vite build && electron-builder --mac --x64",
    "build:mac:arm64": "vite build && electron-builder --mac arm64",
    "build:win": "vite build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.95.2",
    "axios": "^1.14.1",
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.20",
    "iconv-lite": "^0.7.2",
    "lodash": "^4.18.1",
    "lucide-react": "^1.0.1",
    "playwright": "^1.59.1",
    "puppeteer": "^24.40.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "technicalindicators": "^3.1.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "electron": "^35.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "prebuild-install": "^7.1.3",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.fqmsystem.yaodi",
    "productName": "尧帝智能系统",
    "copyright": "Copyright © 2026 FQMSystem",
    "files": [
      "dist/**",
      "server/**",
      "node_modules/**",
      "public/**",
      "package.json",
      "electron/**"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "launcher/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "launcher/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/bindings/**",
      "node_modules/file-uri-to-path/**",
      "node_modules/puppeteer/**",
      "node_modules/@puppeteer/**",
      "node_modules/technicalindicators/**"
    ]
  },
  "description": "尧帝智能量化交易系统",
  "author": "FQMSystem",
  "license": "UNLICENSED"
}
